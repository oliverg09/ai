<odoo>

    <record model="ir.ui.view" id="ai_tool_form_view">
        <field name="model">ai.tool</field>
        <field name="arch" type="xml">
            <form>
                <header />
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="description" />
                        <field name="implementation" />
                        <field name="kind" />
                        <field
                            name="model_id"
                            invisible="implementation != 'method' and kind != 'record'"
                        />
                        <field
                            name="function_name"
                            invisible="implementation != 'method'"
                        />
                    </group>
                    <notebook invisible="implementation != 'code'">
                        <page string="Code" name="code">
                            <field name="code" widget="ace" nolabel="1" />
                        </page>
                        <page string="Schema" name="schema">
                            <group>
                                <field name="required_inputs" />
                                <field
                                    name="input_schema"
                                    widget="text"
                                    placeholder='{"partner_id": {"type": "integer"}}'
                                />
                                <field
                                    name="output_schema"
                                    widget="text"
                                    placeholder='{"name": {"type": "string"}}'
                                />
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="ai_tool_search_view">
        <field name="model">ai.tool</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
            </search>
        </field>
    </record>

    <record model="ir.ui.view" id="ai_tool_tree_view">
        <field name="model">ai.tool</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="implementation" />
                <field name="kind" />
            </list>
        </field>
    </record>

    <record model="ir.actions.act_window" id="ai_tool_act_window">
        <field name="name">AI Tool</field>
        <field name="res_model">ai.tool</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

    <record model="ir.ui.menu" id="ai_tool_menu">
        <field name="name">AI Tool</field>
        <field name="parent_id" ref="ai_menu_root" />
        <field name="action" ref="ai_tool_act_window" />
        <field name="sequence" eval="16" />
    </record>

</odoo>
